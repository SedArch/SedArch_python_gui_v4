TITLE = "Delta- very simple delta with only 2 sediment types"
OUTFILE = "C:/Users/prash/OneDrive/Desktop/Claude/sedarch_python_gui_v4/Output/delta_out.vvm" ! Output file
SED_DIAMETERS = 0.1 1 ! Sediment diameters in mm
CELLSIDE = 100 ! Cell side in m
INCLUDE = "maps/top_slope_4p_60x40.vvm" ! Initial topography
SED1 = 0.5 ! Base sediment proportions
SED2 = 0.5
STEP_DURATION = 3 ! Step duration in ka
STEP_COUNT = 40   ! Number of steps
SEALEVEL = 0.0    ! Initial sea level
TIME_SEALEVEL_CURVE = ! Sea-level curve (if single entry: constant)
0.0 0.0

DISP_FACTOR = 0.01 ! Base dispersion factor (m^2/ka)
INCLUDE = "curves/dispersion_curve.vvm" ! Dispersion factor multiplier as function of depth

CHANNEL_FACTOR = 1 ! Channel flow and sediment input multiplier
CHANNEL_REWORK_FACTOR = 0.02! Inensity of channel reqorking (transverse transport)

CHANNEL_SOURCES =! Channel sources (X(m), Y(m), Water(m^3/s), SED1 (m^3/s) ...
  560 2040 900 0.00001 0.00001
