CHANNEL_EVENT_DURATION = 1 ! Duration of initial flow (in seconds)! seconds
CHANNEL_SOURCES = ! Channel sources (X(m), Y(m), Water(m^3/s), SED1 (m^3/s) ...
  500 2400 2000000 1 1 1 1
