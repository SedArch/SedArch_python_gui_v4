SED4 = 0.25
SEALEVEL = 150 ! Initial sea level in m
STEP_DURATION = 3 ! Step duration in ka
STEP_COUNT = 40 ! Number of steps

TIME_SEALEVEL_CURVE = ! Sea-level curve (if single entry: constant)
 0 150
 120 300

! Accumulation rates (m/ka) and IDs of 4 different sediment types
GROWTH_FACTOR = 0.03
GROWTH_SED_ID = 1

GROWTH_FACTOR = 0.03
GROWTH_SED_ID = 2

GROWTH_FACTOR = 0.03
GROWTH_SED_ID = 3

GROWTH_FACTOR = 0.03
GROWTH_SED_ID = 4

DISP_FACTOR = 0.1

CHANNEL_FACTOR = 2 ! Channel flow and sediment input multiplier
CHANNEL_REWORK_FACTOR = 0.01 ! Inensity of channel reworking (transverse transport)
